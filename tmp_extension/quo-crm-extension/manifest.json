{
  "manifest_version": 3,
  "name": "Quo CRM Lead Capture",
  "version": "1.0.1",
  "description": "Capture selected text from quo.com chats and create CRM leads without leaving the page.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://quo.com/*",
    "https://*.quo.com/*",
    "https://geocoding.geo.census.gov/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://quo.com/*",
        "https://*.quo.com/*"
      ],
      "all_frames": true,
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://marshmallow-crm.lovable.app/*",
        "http://localhost:*/*",
        "https://localhost:*/*"
      ],
      "js": [
        "crm-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html"
}
